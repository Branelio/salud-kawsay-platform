{
  "name": "salud-kawsay-platform",
  "version": "1.0.0",
  "description": "Plataforma Omnicanal de Salud Kawsay - Enfermería y Cuidado Domiciliario Ecuador",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "start": "npm --prefix services/api start",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix services/api run build",
    "build": "npm run build:api && npm run build:web",
    "test": "npm --prefix services/api test",
    "dev:api": "npm --prefix services/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "dev": "npm run dev:api"
  }
}
