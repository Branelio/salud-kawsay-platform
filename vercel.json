{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "api": {
      "root": "services/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/((?!api/).*)",
      "destination": { "service": "web" }
    }
  ]
}
