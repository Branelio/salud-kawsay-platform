# Puerto del servidor API
PORT=4000

# Clave secreta para firma criptográfica de tokens JWT
JWT_SECRET=super_secret_jwt_kawsay_key_2026_change_in_production

# URL de conexión a la Base de Datos PostgreSQL (ej. Supabase, Neon o RDS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/salud_kawsay?schema=public

# Configuración de WhatsApp Cloud API (Meta Developers)
WHATSAPP_API_TOKEN=your_meta_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=kawsay_webhook_verify_token

